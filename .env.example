# Copy to a local .env or pass via --dart-define. Never commit real secrets.
# The anon key is public by design; the service role must never enter this file.

SUPABASE_URL=
SUPABASE_ANON_KEY=
PENUMBRA_CONTROLLER_NAME=Penumbra controller (placeholder)
PENUMBRA_CONTROLLER_EMAIL=privacy@example.invalid
PENUMBRA_ORIGIN=http://localhost
# Optional. Without it, echoes stay local.
# GEMINI_API_KEY=
